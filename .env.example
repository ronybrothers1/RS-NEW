# Production database (preferred)
# Use a managed PostgreSQL URL reachable from Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# Optional elevated connection used only for Drizzle schema operations.
# If omitted, Drizzle falls back to DATABASE_URL.
DATABASE_ADMIN_URL="postgresql://ADMIN:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# Legacy discrete PostgreSQL settings (optional fallback when DATABASE_URL is not used)
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
SQL_SSL="true"
SQL_SSL_REJECT_UNAUTHORIZED="true"
SQL_POOL_MAX="5"

# Auth.js / NextAuth secret. Generate a strong random value for production.
AUTH_SECRET=""

# Canonical public URL.
# Example: https://www.ruangsejahtera.web.id
# If omitted on Vercel, the app falls back to VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL.
NEXT_PUBLIC_SITE_URL=""

# Optional initial admin password used only when running the seed script.
ADMIN_DEFAULT_PASSWORD=""

# Optional Gemini integration, only required by features that call Gemini.
GEMINI_API_KEY=""

# Optional application URL retained for compatibility with AI Studio integrations.
APP_URL=""

# Transactional email for public-user verification.
RESEND_API_KEY=""
EMAIL_FROM="Ruang Sejahtera <noreply@ruangsejahtera.web.id>"

# Private Vercel Blob store used for assistance media and donation proofs.
ASSISTANCE_READ_WRITE_TOKEN=""

# Optional legacy public Blob token.
# Only needed while migrating/deleting old public donation proof blobs.
BLOB_READ_WRITE_TOKEN=""
